# Whitelist: everything is ignored unless listed here. A new top-level file
# or directory must be added on purpose, so nothing slips into a commit.
/*
!/.gitignore
!/.dockerignore
!/.github/
!/LICENSE
!/README.md
!/Cargo.toml
!/Cargo.lock
!/Containerfile
!/build/
!/charts/
!/crates/
!/deploy/
!/docs/
!/extension/

# Build output inside the listed directories.
target/
node_modules/
/extension/dist-pkg/
/extension/tmp/
/extension/pkg/*/.shell
/charts/*/charts/
*.tgz
.DS_Store
